{
  "rules": {
    ".read": false,
    ".write": false,

    "messages": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['uid', 'name', 'message', 'at']) && newData.child('uid').val() === auth.uid && newData.child('at').val() === now && newData.parent().parent().child('rateLimit').child(auth.uid).val() === now",
        "uid": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40 && !newData.val().toLowerCase().contains('://') && !newData.val().toLowerCase().beginsWith('www.') && !newData.val().toLowerCase().contains(' www.')"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500 && !newData.val().toLowerCase().contains('://') && !newData.val().toLowerCase().beginsWith('www.') && !newData.val().toLowerCase().contains(' www.')"
        },
        "location": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "device": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "rateLimit": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || data.val() <= now - 3000)"
      }
    }
  }
}
